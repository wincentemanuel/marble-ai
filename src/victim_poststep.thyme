(e)=>{
    scene.my.v09Setup != true ? { scene.my.runSetup() } : {};
    this._mr3Init != true ? {
        this._mr3Init = true;
        this._prevVy = 0.0;
        this._d0 = [9999, 9999];
        this._d1 = [9999, 9999];
        this._d2 = [9999, 9999];
        this._d3 = [9999, 9999];
        this._lastGx = -9999;
        this._lastGy = -9999;
        this._lastCell = -1;
        this._wasAir = false;
        this._vAir = 0;
        this._vGnd = 0;
        this._vPeakAir = 0;
        this._vLastK = -1;
        this._vLastGX = pos(0);
        this._vLastGVx = vel(0);
        this._vRefK = -1;
        this._vPvy = vel(1)
    } : {};
    _vgx := scene.my.flr(pos(0) / scene.my.cs) + 500;
    _vgy := scene.my.flr(pos(1) / scene.my.cs) + 500;
    _vFall := (vel(1) - this._vPvy) < -0.1;
    _vCellChanged := (_vgx != this._lastGx || _vgy != this._lastGy);
    _justLanded := (!_vFall && this._wasAir);
    (_vCellChanged || _justLanded || _vFall) ? {
        scene.my.recTick(pos(0), pos(1), vel(0), vel(1), this._vPvy, this._vAir, this._vGnd, this._vPeakAir, this._vLastK, this._vLastGX, this._vLastGVx, this._vRefK, 0, 0);
        this._vAir = scene.my.oAir;
        this._vGnd = scene.my.oGnd;
        this._vPeakAir = scene.my.oPeakAir;
        this._vLastK = scene.my.oLastK;
        this._vLastGX = scene.my.oLastGX;
        this._vLastGVx = scene.my.oLastGVx;
        this._vRefK = scene.my.oRefK;
        (!_vFall && this._vGnd >= 1) ? {
            this._lastGx = _vgx;
            this._lastGy = _vgy;
            this._lastCell = _vgx * 1000 + _vgy;
            scene.my.ensureCell(this._lastCell);
            scene.my.bfDirty = true;
            scene.my.bfResweep = true
        } : {}
    } : {};
    this._vPvy = vel(1);
    this._wasAir = _vFall;
    _vCellNow := (!_vFall) ? (_vgx * 1000 + _vgy) : ((this._lastCell != -1) ? this._lastCell : (_vgx * 1000 + _vgy));
    scene.my.addVCell(_vCellNow);
    _tippedDown := (vel(1) < -2.4 && this._prevVy >= -2.4);
    this._prevVy = vel(1);
    _tippedDown ? {
        this._d3 = this._d2;
        this._d2 = this._d1;
        this._d1 = this._d0;
        this._d0 = pos
    } : {};
    _dx := pos(0) - scene.my.seekerPos(0);
    _dy := pos(1) - scene.my.seekerPos(1);
    _dist := math.sqrt(_dx * _dx + _dy * _dy);
    _upPenalty := (_dy > 1.0) ? (_dy * 15.0) : 0.0;
    _wallPenalty := ((_dy > -0.9 && _dy < 1.0) && ((_dx > 0.5 && scene.my.blockedRight) || (_dx < -0.5 && scene.my.blockedLeft))) ? 18.0 : 0.0;
    _score := _dist + _upPenalty + _wallPenalty;
    (scene.my.hasTarget != true || _score < scene.my.bestScore) ? {
        scene.my.bestScore = _score;
        scene.my.targetPos = pos;
        scene.my.targetVel = vel;
        _vCellNow != scene.my.targetCell ? {
            scene.my.bfDirty = true;
            scene.my.bfResweep = true
        } : {};
        scene.my.targetCell = _vCellNow;
        scene.my.d0 = this._d0;
        scene.my.d1 = this._d1;
        scene.my.d2 = this._d2;
        scene.my.d3 = this._d3;
        scene.my.hasTarget = true
    } : {}
}