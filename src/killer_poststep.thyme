                        scene.my.kState = "MICRO_BACKOFF";
                        _desiredVx = scene.my.microBackDir * 2.2;
                        _traction = 0.28
                    } : {
                        scene.my.microSurge > 0 ? {
                            scene.my.microSurge = scene.my.microSurge - 1;
                            _desiredVx = scene.my.microSurgeDir * _chaseSpeed * 1.35;
                            _traction = 0.30
                        } : {}
                    };
                    _uphill := ((_desiredVx > 0 && scene.my.kGroundNx < -0.20) || (_desiredVx < 0 && scene.my.kGroundNx > 0.20));
                    (scene.my.kAir == 0 && scene.my.kGroundContactTick >= (scene.my.tk - 2) && scene.my.kGroundNy > 0.55 && _absGNx > 0.20 && _uphill && scene.my.holeDropTimer <= 0 && scene.my.backoff <= 0 && scene.my.microBackoff <= 0) ? {
                        _desiredVx = _desiredVx * 1.45;
                        _traction = 0.32;
                        adhesion = 2.0
                    } : {
                        adhesion = 0.0
                    }
                };
                scene.my.lastDesiredVx = _desiredVx
            }
        } : {};

        scene.my.passiveBreakoutTimer <= 0 ? {
            angvel = -_desiredVx / _r;
            vel = [vel(0) + (_desiredVx - vel(0)) * _traction, vel(1)];
            scene.my.kState == "DIRECT_CHASE" ? {
                scene.my.hudThought = "DIRECT_STRIKE -> locking onto nearby victim"
            } : {
                scene.my.kState == "ACTIVE_PATROL" ? {
                    scene.my.hudThought = "ACTIVE_PATROL -> driving to elevated/unexplored cells"
                } : {
                    scene.my.hudThought = (_activeUse >= 1) ? "I have been here before -> taking alternate branch" : "Tracking target -> hunting victim"
                }
            }
        } : {
            scene.my.modeLabel = "PASSIVE_EXPLORE";
            scene.my.kState = "PASSIVE_EXPLORE";
            color = [0.6, 0.85, 1.0, 1];
            friction = 0.0;
            restitution = 0.18;
            adhesion = 0.0;
            scene.my.hudThought = (scene.my.curCellHeat >= 15.0) ? "I have been here before -> rolling free to find new route" : "Exploring new territory -> rolling as natural marble"
        }
    } : {
        scene.my.windupPhase = 0;
        scene.my.activeHop = -1;
        scene.my.lastUsedHop = -1;
        scene.my.edgeAttemptTicks = 0;
        scene.my.famLoopTimer = 0;
        scene.my.unstickTimer > 0 ? {
            scene.my.unstickTimer = scene.my.unstickTimer - 1;
            scene.my.modeLabel = "UNSTICK_NUDGE";
            scene.my.kState = "UNSTICK_NUDGE";
            color = [1.0, 0.7, 0.2, 1];
            friction = 0.8;
            restitution = 0.12;
            adhesion = 0.0;
            _nudgeVx := scene.my.unstickDir * 2.4;
            angvel = -_nudgeVx / _r;
            vel = [vel(0) + (_nudgeVx - vel(0)) * 0.28, vel(1)];
            scene.my.unstickTimer <= 0 ? {
                friction = 0.0;
                restitution = 0.18;
                scene.my.unstickIdleTicks = 0
            } : {}
        } : {
            scene.my.modeLabel = "PASSIVE_EXPLORE";
            scene.my.kState = "PASSIVE_EXPLORE";
            color = [0.6, 0.85, 1.0, 1];
            friction = 0.0;
            restitution = 0.18;
            adhesion = 0.0;
            (scene.my.passiveBreakoutTimer <= 0 && _graphCost >= 90000 && scene.my.nCells > 0) ? {
                scene.my.nCells > scene.my.passiveLastCells ? {
                    scene.my.passiveLastCells = scene.my.nCells;
                    scene.my.passiveStaleTicks = 0
                } : {
                    scene.my.passiveStaleTicks = scene.my.passiveStaleTicks + 1;
                    scene.my.passiveStaleTicks > 300 ? {
                        scene.my.pickPatrolTarget(0);
                        scene.my.patrolTimer = 180;
                        scene.my.passiveStaleTicks = 0;
                        scene.my.passiveLastCells = scene.my.nCells;
                        scene.my.logEv("active_patrol")
                    } : {}
                }
            } : {};
            _spd := math.sqrt(vel(0) * vel(0) + vel(1) * vel(1));
            _spd < 0.18 ? {
                scene.my.unstickIdleTicks = scene.my.unstickIdleTicks + 1;
                scene.my.unstickIdleTicks >= 75 ? {
                    scene.my.unstickDir = scene.my.pickUnstickDir(_kCellNow, scene.my.unstickDir);
                    scene.my.unstickTimer = 35;
                    scene.my.unstickIdleTicks = 0;
                    scene.my.logEv("unstick_nudge")
                } : {}
            } : {
                scene.my.unstickIdleTicks = 0
            }
        };
        scene.my.hudThought = (scene.my.curCellHeat >= 15.0) ? "I have been here before -> rolling free to find new route" : "Exploring new territory -> rolling as natural marble"
    };

    scene.my.tk = scene.my.tk + 1;
    scene.my.tk % 5 == 0 ? {
        scene.my.dump = "x=" + pos(0) + " y=" + pos(1) + " m=" + scene.my.modeLabel + " kC=" + scene.my.kCell + " h=" + scene.my.curCellHeat + " hop=" + scene.my.hudHop + " cost=" + scene.my.hudCost + " bT=" + scene.my.passiveBreakoutTimer + " pT=" + scene.my.patrolTimer + " uT=" + scene.my.unstickTimer + " nC=" + scene.my.nCells + " nW=" + scene.my.nWalk + " nF=" + scene.my.nFall
    } : {};
    (scene.my.hasTarget != true && scene.my.nVCells == 0) ? {
        scene.my.targetCell = -1
    } : {};
    scene.my.hudTick = scene.my.hudTick + 1;
    scene.my.hudTick >= 6 ? {
        scene.my.hudTick = 0;
        _totE := scene.my.nWalk + scene.my.nFall;
        _hopStr := (scene.my.hudHop == "NONE") ? "NONE" : (scene.my.hudHop + "(" + scene.my.hudMode + ")");
        _hdrMode := (scene.my.modeLabel == "ACTIVE_HUNTER") ? ("ACTIVE_HUNTER (" + scene.my.kState + ")") : scene.my.modeLabel;
        scene.my.hudText = "V0.9 | " + _hdrMode + " | hop=" + _hopStr + " cost=" + scene.my.hudCost + "\n" + scene.my.hudThought + "\nheat=" + scene.my.curCellHeat + " use=" + scene.my.hudUse + " cells=" + scene.my.nCells + " walk=" + scene.my.nWalk + " fall=" + scene.my.nFall + "\nkCell=" + scene.my.kCell + " targetCell=" + scene.my.targetCell + " bT=" + scene.my.passiveBreakoutTimer + " pT=" + scene.my.patrolTimer + " sT=" + scene.my.passiveStaleTicks + "\nbf=" + scene.my.bfCursor + "/" + _totE + " g=" + scene.my.bfGen + " uT=" + scene.my.unstickTimer + " wP=" + scene.my.windupPhase;
        scene.my.hudVer = scene.my.hudVer + 1
    } : {};
    scene.my.vCells = [];
    scene.my.nVCells = 0;
    scene.my.bestScore = 99999;
    scene.my.hasTarget = false
}